# Local development: never enter real personal data in demo mode.
APP_MODE=demo
APP_ORIGIN=http://127.0.0.1:3000
# Optional locally; set a strong secret if retaining demo sessions across restarts.
SESSION_SECRET=
# Follow-up D2: a server-only PostgreSQL URL. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# Follow-up R2: JWT subject must match a provisioned user_profiles.id.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
